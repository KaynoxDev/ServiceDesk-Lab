# ============================================================
#  ServiceDesk Lab — .gitattributes
#  Controle les fins de ligne. Projet mixte Windows + Linux.
# ============================================================

# Par defaut : Git normalise en LF dans le depot
* text=auto eol=lf

# ---------- Fichiers WINDOWS : CRLF obligatoire ----------
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.psd1   text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.reg    text eol=crlf
*.xml    text eol=crlf

# ---------- Fichiers LINUX : LF obligatoire ----------
# Un .sh en CRLF est INEXECUTABLE sur Debian
*.sh     text eol=lf
*.conf   text eol=lf
*.service text eol=lf
Makefile text eol=lf

# ---------- Binaires : aucune transformation ----------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.docx   binary
*.xlsx   binary
